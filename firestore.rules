rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ladanikishan8@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    match /{document=**} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.keys().hasAll(['serviceId', 'clientName', 'clientPhone', 'date', 'timeSlot', 'status']) &&
        request.resource.data.status == 'pending'
      );
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.clientPhone != null);
      allow update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appBuilds/{buildId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == adminId && (
        request.auth.token.email == 'ladanikishan8@gmail.com' ||
        request.resource.data.get('isDemo', false) == true
      );
      allow update, delete: if isAdmin();
    }
  }
}
